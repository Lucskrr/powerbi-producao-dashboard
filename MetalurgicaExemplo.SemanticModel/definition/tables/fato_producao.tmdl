	partition fato_producao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\fato_producao.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"id_movimentacao", Int64.Type}, {"data", type date}, {"cd_setor", Int64.Type}, {"nr_op", type text}, {"cd_familia", Int64.Type}, {"pecas", Int64.Type}, {"valor_servico", type number}}, "en-US")
				in
				    Tipos
