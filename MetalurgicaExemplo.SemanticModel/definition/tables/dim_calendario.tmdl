	partition dim_calendario = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\dim_calendario.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"data", type date}, {"ano", Int64.Type}, {"mes_num", Int64.Type}, {"mes_ano", type text}, {"mes_ano_ordem", Int64.Type}, {"dia_semana", type text}, {"dia_util", Int64.Type}}, "en-US")
				in
				    Tipos
