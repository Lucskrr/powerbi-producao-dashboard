table dim_faixa_premio
	lineageTag: 983be405-92ca-5ddd-aef6-bfbe12584c22

	column eficiencia_min
		dataType: double
		summarizeBy: none
		sourceColumn: eficiencia_min
		lineageTag: fe3a9d8c-db2f-5192-9e41-d991d6c36a7d

	column eficiencia_max
		dataType: double
		summarizeBy: none
		sourceColumn: eficiencia_max
		lineageTag: 976da138-7d32-5139-841e-7745224dcc18

	column pct_diaria_premio
		dataType: double
		summarizeBy: none
		sourceColumn: pct_diaria_premio
		lineageTag: 0e064d39-8c7f-534b-b64f-a68e68bb862e

	partition dim_faixa_premio = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\dim_faixa_premio.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"eficiencia_min", type number}, {"eficiencia_max", type number}, {"pct_diaria_premio", type number}}, "en-US")
				in
				    Tipos
