	partition fato_custo_setor_dia = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\fato_custo_setor_dia.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
