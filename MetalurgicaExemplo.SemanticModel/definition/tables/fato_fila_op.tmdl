	partition fato_fila_op = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "\fato_fila_op.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalho, {{"nr_op", type text}, {"cd_setor", Int64.Type}, {"cd_familia", Int64.Type}, {"pecas", Int64.Type}, {"valor_servico_restante", type number}, {"data_ultima_movimentacao", type date}}, "en-US")
				in
				    Tipos
